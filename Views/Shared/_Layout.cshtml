@using Newtonsoft.Json
@using Smart_Grocery_Store_Web_App.Models
@{
    var cartJson = Context.Session.GetString("CART");
    var cartItems = string.IsNullOrEmpty(cartJson)
        ? new List<CartItem>()
        : JsonConvert.DeserializeObject<List<CartItem>>(cartJson);

    var cartCount = cartItems.Sum(x => x.Quantity);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Smart Grocery</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>

<body style="background:#031b12">

    <nav class="navbar navbar-expand-lg navbar-dark" style="background:#198754;">
        <div class="container-fluid">

            <a class="navbar-brand fw-bold text-white" href="/">Smart Grocery</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navBar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navBar">
                <ul class="navbar-nav ms-auto align-items-center gap-3">

                    <li class="nav-item">
                        <a class="nav-link text-white" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Product">Products</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white fw-bold" href="/Cart">
                            Cart (@cartCount)
                        </a>
                    </li>

                    @if (Context.Session.GetString("USER_NAME") != null)
                    {
                        <li class="nav-item text-white">
                            Hi, <b>@Context.Session.GetString("USER_NAME")</b>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-sm btn-outline-light" href="/Auth/Logout">Logout</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-sm btn-outline-light" href="/Auth/Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-sm btn-light" href="/Auth/Register">Register</a>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <!-- JS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    @RenderSection("Scripts", required: false)

    <div id="toastBox" class="toast-msg"></div>

</body>
</html>
