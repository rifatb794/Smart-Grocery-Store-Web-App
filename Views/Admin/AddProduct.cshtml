@model Smart_Grocery_Store_Web_App.Models.Product

<h2 class="fw-bold mb-3">Add Product</h2>

<form method="post">
    <input class="form-control mb-2" name="Name" placeholder="Name" required />
    <input class="form-control mb-2" name="Price" placeholder="Price" required />
    <input class="form-control mb-2" name="Stock" placeholder="Stock" required />
    <input class="form-control mb-2" name="Category" placeholder="Category" />
    <input class="form-control mb-2" name="ImageUrl" placeholder="Image URL" />
    <button class="btn btn-success w-100">Add Product</button>
</form>
