<h2>Add Product</h2>

<form method="post" enctype="multipart/form-data">

    <input name="Name"
           class="form-control mb-2"
           placeholder="Product Name"
           required />

    <input name="Price"
           type="number"
           step="0.01"
           class="form-control mb-2"
           placeholder="Price"
           required />

    <input name="Stock"
           type="number"
           class="form-control mb-2"
           placeholder="Stock Quantity"
           required />

    <input name="Category"
           class="form-control mb-2"
           placeholder="Category"
           required />

    <div class="form-check mb-2">
        <input type="checkbox"
               name="IsPopular"
               class="form-check-input"
               value="true" />
        <label class="form-check-label">
            Popular Product
        </label>
    </div>

    <!-- IMAGE UPLOAD -->
    <input type="file"
           name="Image"
           class="form-control mb-3"
           accept="image/*"
           required />

    <button class="btn btn-success w-100">
        Save
    </button>

</form>
